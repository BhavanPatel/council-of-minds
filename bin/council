#!/usr/bin/env bash
# council — CLI for Council of Minds: install and manage the advisor + researcher Minds
# Installed to: /usr/local/bin/council (or ~/.local/bin/council)
set -eo pipefail

INSTALL_DIR="${HOME}/.council-of-minds"
VERSION="5.0.0"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'
BOLD='\033[1m'

usage() {
  echo ""
  echo -e "  ${PURPLE}${BOLD}council${NC} — Multi-advisor deliberation for AI agents"
  echo ""
  echo "  Usage: council <command> [options]"
  echo ""
  echo "  Commands:"
  echo "    install          Install/reinstall council for detected AI clients"
  echo "    update           Pull latest changes and reinstall"
  echo "    status           Show current installation status"
  echo "    disable          Temporarily disable (renames files, keeps them)"
  echo "    enable           Re-enable previously disabled council"
  echo "    uninstall        Remove council from all AI clients"
  echo "    advisor <sub>    Manage custom advisors (create/validate/list)"
  echo "    researcher <sub> Manage custom researchers (create/validate/list)"
  echo "    version          Show version"
  echo "    help             Show this help"
  echo ""
  echo "  Options:"
  echo "    --client <list>  Comma-separated clients (kiro,claude,cursor,...)"
  echo ""
  echo "  Examples:"
  echo "    council install                  # Auto-detect + interactive"
  echo "    council install --client kiro    # Install for Kiro only"
  echo "    council update                   # Pull latest + reinstall"
  echo "    council status                   # Show what's installed"
  echo "    council disable                  # Temporarily disable"
  echo "    council enable                   # Re-enable"
  echo "    council uninstall                # Remove from all clients"
  echo "    council advisor create quant     # Scaffold a custom advisor"
  echo "    council advisor validate quant   # Check a custom advisor's structure"
  echo "    council advisor list             # List custom advisors"
  echo "    council researcher create billing-telemetry  # Scaffold a custom researcher"
  echo ""
}

check_installed() {
  if [[ ! -d "$INSTALL_DIR" ]]; then
    echo -e "  ${RED}✗${NC} Council of Minds not installed. Run:"
    echo "    git clone <repo-url> ~/.council-of-minds && ~/.council-of-minds/install.sh"
    exit 1
  fi
}

# ─────────────────────────────────────────────────────────────────────────────
# Install
# ─────────────────────────────────────────────────────────────────────────────

cmd_install() {
  check_installed
  cd "$INSTALL_DIR"
  exec bash ./install.sh "$@"
}

# ─────────────────────────────────────────────────────────────────────────────
# Update
# ─────────────────────────────────────────────────────────────────────────────

cmd_update() {
  check_installed
  echo -e "  ${CYAN}Updating Council of Minds...${NC}"
  echo ""

  cd "$INSTALL_DIR"
  local before
  before=$(git rev-parse HEAD 2>/dev/null || echo "unknown")

  git pull --quiet 2>/dev/null || {
    echo -e "  ${RED}✗${NC} Git pull failed. Is ~/.council-of-minds a git repository?"
    exit 1
  }

  local after
  after=$(git rev-parse HEAD)

  if [[ "$before" == "$after" ]]; then
    echo -e "  ${GREEN}✓${NC} Already up to date (${after:0:7})"
    return 0
  fi

  local count
  count=$(git log --oneline "$before".."$after" | wc -l | tr -d ' ')
  echo -e "  ${GREEN}✓${NC} Updated (${count} new commit(s))"
  echo ""

  # Show change summary for advisors, config, and main prompt
  echo -e "  ┌──────────────────────────────────────────────────┐"
  echo -e "  │  ${CYAN}Changes that will be applied:${NC}                    │"
  echo -e "  ├──────────────────────────────────────────────────┤"
  echo ""

  # Detect advisor changes
  echo -e "  ${BLUE}Advisors:${NC}"

  # Check for new/modified/removed advisors
  local diff_output
  diff_output=$(git diff --name-status "$before".."$after" -- advisors/ 2>/dev/null || true)
  if [[ -n "$diff_output" ]]; then
    while IFS=$'\t' read -r status file; do
      local fname
      fname="$(basename "$file")"
      case "$status" in
        A) echo -e "    ${GREEN}+${NC} ${fname}  ${GREEN}(new advisor)${NC}" ;;
        M) echo -e "    ${YELLOW}~${NC} ${fname}  ${YELLOW}(modified)${NC}" ;;
        D) echo -e "    ${RED}-${NC} ${fname}  ${RED}(removed)${NC}" ;;
      esac
    done <<< "$diff_output"
  else
    echo -e "    · No advisor changes"
  fi

  # Check main prompt
  echo ""
  echo -e "  ${BLUE}Council Prompt:${NC}"
  if git diff --quiet "$before".."$after" -- council-of-minds.md 2>/dev/null; then
    echo -e "    · council-of-minds.md  (unchanged)"
  else
    echo -e "    ${YELLOW}~${NC} council-of-minds.md  ${YELLOW}(modified)${NC}"
  fi

  # Check config
  echo ""
  echo -e "  ${BLUE}Config:${NC}"
  if git diff --quiet "$before".."$after" -- settings/ council-of-minds.json 2>/dev/null; then
    echo -e "    · config  (unchanged)"
  else
    echo -e "    ${YELLOW}~${NC} config  ${YELLOW}(modified)${NC}"
  fi

  echo ""
  echo -e "  └──────────────────────────────────────────────────┘"
  echo ""

  # Ask before proceeding
  read -rp "  Proceed with reinstall? [Y/n]: " confirm </dev/tty
  if [[ "$confirm" =~ ^[Nn] ]]; then
    echo -e "  ${YELLOW}Skipped reinstall.${NC} Run 'council install' when ready."
    return 0
  fi

  echo ""
  echo -e "  Reinstalling..."
  echo ""

  # Run install (which will copy fresh files including any new/removed advisors)
  exec bash ./install.sh "$@"
}

# ─────────────────────────────────────────────────────────────────────────────
# Status
# ─────────────────────────────────────────────────────────────────────────────

cmd_status() {
  echo ""
  echo -e "  ${PURPLE}${BOLD}Council of Minds — Status${NC}"
  echo ""

  # Installation dir
  if [[ -d "$INSTALL_DIR" ]]; then
    echo -e "  ${GREEN}✓${NC} Installed at: ${INSTALL_DIR}"
    local commit
    commit=$(cd "$INSTALL_DIR" && git log --oneline -1 2>/dev/null || echo "unknown")
    echo -e "    Version: ${commit}"
  else
    echo -e "  ${RED}✗${NC} Not installed"
    return
  fi

  echo ""

  # Disabled state
  if [[ -f "${INSTALL_DIR}/.disabled" ]]; then
    echo -e "  State: ${YELLOW}DISABLED${NC} (run 'council enable' to restore)"
  else
    echo -e "  State: ${GREEN}ACTIVE${NC}"
  fi

  echo ""
  echo "  Clients configured:"

  # Kiro
  [[ -d "${HOME}/.kiro/agents/council-of-minds" ]] && echo -e "    ${GREEN}✓${NC} Kiro"

  # Claude
  if [[ -f "${HOME}/.claude/CLAUDE.md" ]] && grep -q "council-of-minds" "${HOME}/.claude/CLAUDE.md" 2>/dev/null; then
    echo -e "    ${GREEN}✓${NC} Claude Code"
  fi

  # Cursor
  [[ -f "${HOME}/.cursor/rules/council-of-minds.md" ]] && echo -e "    ${GREEN}✓${NC} Cursor"

  # Windsurf
  [[ -f "${HOME}/.windsurf/rules/council-of-minds.md" ]] && echo -e "    ${GREEN}✓${NC} Windsurf"

  # Cline
  [[ -f "${HOME}/.cline/rules/council-of-minds.md" ]] && echo -e "    ${GREEN}✓${NC} Cline"

  # Aider
  [[ -d "${HOME}/.aider/council-of-minds" ]] && echo -e "    ${GREEN}✓${NC} Aider"

  # RooCode
  [[ -f "${HOME}/.roo/rules/council-of-minds.md" ]] && echo -e "    ${GREEN}✓${NC} RooCode"

  # OpenCode
  [[ -d "${HOME}/.opencode/council-of-minds" ]] && echo -e "    ${GREEN}✓${NC} OpenCode"

  # GitHub Copilot
  if [[ -f "${HOME}/.github/copilot-instructions.md" ]] && grep -q "Council of Minds" "${HOME}/.github/copilot-instructions.md" 2>/dev/null; then
    echo -e "    ${GREEN}✓${NC} GitHub Copilot"
  fi

  # Codex
  if [[ -f "${HOME}/AGENTS.md" ]] && grep -q "Council of Minds" "${HOME}/AGENTS.md" 2>/dev/null; then
    echo -e "    ${GREEN}✓${NC} OpenAI Codex"
  fi

  echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# Uninstall
# ─────────────────────────────────────────────────────────────────────────────

cmd_uninstall() {
  echo -e "  ${YELLOW}This will remove Council of Minds from all AI clients.${NC}"
  read -rp "  Continue? [y/N]: " confirm </dev/tty

  if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
    echo "  Cancelled."
    exit 0
  fi

  echo ""

  # Kiro
  if [[ -d "${HOME}/.kiro/agents/council-of-minds" ]]; then
    rm -rf "${HOME}/.kiro/agents/council-of-minds"
    rm -f "${HOME}/.kiro/settings/council-of-minds.config.json"
    rm -f "${HOME}/.kiro/settings/decision-council.config.json"
    rm -f "${HOME}/.kiro/settings/research-council.config.json"
    echo -e "  ${GREEN}✓${NC} Removed from Kiro"
  fi

  # Claude
  if [[ -d "${HOME}/.claude/council-of-minds" ]]; then
    rm -rf "${HOME}/.claude/council-of-minds"
    # Remove reference from CLAUDE.md but keep the file
    if [[ -f "${HOME}/.claude/CLAUDE.md" ]]; then
      sed -i '' '/council-of-minds/d' "${HOME}/.claude/CLAUDE.md" 2>/dev/null || true
    fi
    echo -e "  ${GREEN}✓${NC} Removed from Claude Code"
  fi

  # Cursor
  if [[ -f "${HOME}/.cursor/rules/council-of-minds.md" ]]; then
    rm -f "${HOME}/.cursor/rules/council-of-minds.md"
    rm -rf "${HOME}/.cursor/rules/council-advisors"
    rm -rf "${HOME}/.cursor/rules/council-researchers"
    echo -e "  ${GREEN}✓${NC} Removed from Cursor"
  fi

  # Windsurf
  if [[ -f "${HOME}/.windsurf/rules/council-of-minds.md" ]]; then
    rm -f "${HOME}/.windsurf/rules/council-of-minds.md"
    rm -rf "${HOME}/.windsurf/rules/council-advisors"
    rm -rf "${HOME}/.windsurf/rules/council-researchers"
    echo -e "  ${GREEN}✓${NC} Removed from Windsurf"
  fi

  # Cline
  if [[ -f "${HOME}/.cline/rules/council-of-minds.md" ]]; then
    rm -f "${HOME}/.cline/rules/council-of-minds.md"
    rm -rf "${HOME}/.cline/rules/council-advisors"
    rm -rf "${HOME}/.cline/rules/council-researchers"
    echo -e "  ${GREEN}✓${NC} Removed from Cline"
  fi

  # Aider
  if [[ -d "${HOME}/.aider/council-of-minds" ]]; then
    rm -rf "${HOME}/.aider/council-of-minds"
    # Remove reference from .aider.conf.yml
    if [[ -f "${HOME}/.aider.conf.yml" ]]; then
      sed -i '' '/council-of-minds/d' "${HOME}/.aider.conf.yml" 2>/dev/null || true
    fi
    echo -e "  ${GREEN}✓${NC} Removed from Aider"
  fi

  # RooCode
  if [[ -f "${HOME}/.roo/rules/council-of-minds.md" ]]; then
    rm -f "${HOME}/.roo/rules/council-of-minds.md"
    rm -rf "${HOME}/.roo/rules/council-advisors"
    rm -rf "${HOME}/.roo/rules/council-researchers"
    echo -e "  ${GREEN}✓${NC} Removed from RooCode"
  fi

  # OpenCode
  if [[ -d "${HOME}/.opencode/council-of-minds" ]]; then
    rm -rf "${HOME}/.opencode/council-of-minds"
    echo -e "  ${GREEN}✓${NC} Removed from OpenCode"
  fi

  # GitHub Copilot (only if it's ours)
  if [[ -f "${HOME}/.github/copilot-instructions.md" ]] && grep -q "Council of Minds" "${HOME}/.github/copilot-instructions.md" 2>/dev/null; then
    rm -f "${HOME}/.github/copilot-instructions.md"
    echo -e "  ${GREEN}✓${NC} Removed from GitHub Copilot"
  fi

  # Codex (only if it's ours)
  if [[ -f "${HOME}/AGENTS.md" ]] && grep -q "Council of Minds" "${HOME}/AGENTS.md" 2>/dev/null; then
    rm -f "${HOME}/AGENTS.md"
    echo -e "  ${GREEN}✓${NC} Removed from Codex"
  fi

  # Remove CLI itself?
  echo ""
  echo -e "  ${YELLOW}Remove the CLI and ~/.council-of-minds directory?${NC}"
  read -rp "  Remove completely? [y/N]: " confirm2 </dev/tty
  if [[ "$confirm2" == "y" || "$confirm2" == "Y" ]]; then
    rm -rf "$INSTALL_DIR"
    rm -f "/usr/local/bin/council" 2>/dev/null || rm -f "${HOME}/.local/bin/council" 2>/dev/null || true
    echo -e "  ${GREEN}✓${NC} Fully uninstalled"
  else
    echo -e "  ${GREEN}✓${NC} Client rules removed. CLI and source kept."
  fi

  echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# Disable / Enable
# ─────────────────────────────────────────────────────────────────────────────

STATE_FILE="${INSTALL_DIR}/.disabled"

cmd_disable() {
  if [[ -f "$STATE_FILE" ]]; then
    echo -e "  ${YELLOW}Already disabled.${NC} Run 'council enable' to re-enable."
    return
  fi

  echo -e "  ${CYAN}Disabling Council of Minds...${NC}"
  echo ""

  # Kiro — rename agent dir
  if [[ -d "${HOME}/.kiro/agents/council-of-minds" ]]; then
    mv "${HOME}/.kiro/agents/council-of-minds" "${HOME}/.kiro/agents/council-of-minds.disabled"
    echo -e "  ${GREEN}✓${NC} Kiro — disabled"
  fi

  # Claude — rename council dir
  if [[ -d "${HOME}/.claude/council-of-minds" ]]; then
    mv "${HOME}/.claude/council-of-minds" "${HOME}/.claude/council-of-minds.disabled"
    echo -e "  ${GREEN}✓${NC} Claude Code — disabled"
  fi

  # Cursor
  if [[ -f "${HOME}/.cursor/rules/council-of-minds.md" ]]; then
    mv "${HOME}/.cursor/rules/council-of-minds.md" "${HOME}/.cursor/rules/council-of-minds.md.disabled"
    [[ -d "${HOME}/.cursor/rules/council-advisors" ]] && mv "${HOME}/.cursor/rules/council-advisors" "${HOME}/.cursor/rules/council-advisors.disabled"
    [[ -d "${HOME}/.cursor/rules/council-researchers" ]] && mv "${HOME}/.cursor/rules/council-researchers" "${HOME}/.cursor/rules/council-researchers.disabled"
    echo -e "  ${GREEN}✓${NC} Cursor — disabled"
  fi

  # Windsurf
  if [[ -f "${HOME}/.windsurf/rules/council-of-minds.md" ]]; then
    mv "${HOME}/.windsurf/rules/council-of-minds.md" "${HOME}/.windsurf/rules/council-of-minds.md.disabled"
    [[ -d "${HOME}/.windsurf/rules/council-advisors" ]] && mv "${HOME}/.windsurf/rules/council-advisors" "${HOME}/.windsurf/rules/council-advisors.disabled"
    [[ -d "${HOME}/.windsurf/rules/council-researchers" ]] && mv "${HOME}/.windsurf/rules/council-researchers" "${HOME}/.windsurf/rules/council-researchers.disabled"
    echo -e "  ${GREEN}✓${NC} Windsurf — disabled"
  fi

  # Cline
  if [[ -f "${HOME}/.cline/rules/council-of-minds.md" ]]; then
    mv "${HOME}/.cline/rules/council-of-minds.md" "${HOME}/.cline/rules/council-of-minds.md.disabled"
    [[ -d "${HOME}/.cline/rules/council-advisors" ]] && mv "${HOME}/.cline/rules/council-advisors" "${HOME}/.cline/rules/council-advisors.disabled"
    [[ -d "${HOME}/.cline/rules/council-researchers" ]] && mv "${HOME}/.cline/rules/council-researchers" "${HOME}/.cline/rules/council-researchers.disabled"
    echo -e "  ${GREEN}✓${NC} Cline — disabled"
  fi

  # Aider
  if [[ -d "${HOME}/.aider/council-of-minds" ]]; then
    mv "${HOME}/.aider/council-of-minds" "${HOME}/.aider/council-of-minds.disabled"
    echo -e "  ${GREEN}✓${NC} Aider — disabled"
  fi

  # RooCode
  if [[ -f "${HOME}/.roo/rules/council-of-minds.md" ]]; then
    mv "${HOME}/.roo/rules/council-of-minds.md" "${HOME}/.roo/rules/council-of-minds.md.disabled"
    [[ -d "${HOME}/.roo/rules/council-advisors" ]] && mv "${HOME}/.roo/rules/council-advisors" "${HOME}/.roo/rules/council-advisors.disabled"
    [[ -d "${HOME}/.roo/rules/council-researchers" ]] && mv "${HOME}/.roo/rules/council-researchers" "${HOME}/.roo/rules/council-researchers.disabled"
    echo -e "  ${GREEN}✓${NC} RooCode — disabled"
  fi

  # OpenCode
  if [[ -d "${HOME}/.opencode/council-of-minds" ]]; then
    mv "${HOME}/.opencode/council-of-minds" "${HOME}/.opencode/council-of-minds.disabled"
    echo -e "  ${GREEN}✓${NC} OpenCode — disabled"
  fi

  # GitHub Copilot
  if [[ -f "${HOME}/.github/copilot-instructions.md" ]] && grep -q "Council of Minds" "${HOME}/.github/copilot-instructions.md" 2>/dev/null; then
    mv "${HOME}/.github/copilot-instructions.md" "${HOME}/.github/copilot-instructions.md.disabled"
    echo -e "  ${GREEN}✓${NC} GitHub Copilot — disabled"
  fi

  # Codex
  if [[ -f "${HOME}/AGENTS.md" ]] && grep -q "Council of Minds" "${HOME}/AGENTS.md" 2>/dev/null; then
    mv "${HOME}/AGENTS.md" "${HOME}/AGENTS.md.disabled"
    echo -e "  ${GREEN}✓${NC} Codex — disabled"
  fi

  touch "$STATE_FILE"
  echo ""
  echo -e "  ${YELLOW}Council disabled.${NC} AI clients will not see the council."
  echo -e "  Run 'council enable' to restore."
  echo ""
}

cmd_enable() {
  if [[ ! -f "$STATE_FILE" ]]; then
    echo -e "  ${GREEN}Already enabled.${NC} Council is active."
    return
  fi

  echo -e "  ${CYAN}Re-enabling Council of Minds...${NC}"
  echo ""

  # Kiro
  if [[ -d "${HOME}/.kiro/agents/council-of-minds.disabled" ]]; then
    mv "${HOME}/.kiro/agents/council-of-minds.disabled" "${HOME}/.kiro/agents/council-of-minds"
    echo -e "  ${GREEN}✓${NC} Kiro — enabled"
  fi

  # Claude
  if [[ -d "${HOME}/.claude/council-of-minds.disabled" ]]; then
    mv "${HOME}/.claude/council-of-minds.disabled" "${HOME}/.claude/council-of-minds"
    echo -e "  ${GREEN}✓${NC} Claude Code — enabled"
  fi

  # Cursor
  if [[ -f "${HOME}/.cursor/rules/council-of-minds.md.disabled" ]]; then
    mv "${HOME}/.cursor/rules/council-of-minds.md.disabled" "${HOME}/.cursor/rules/council-of-minds.md"
    [[ -d "${HOME}/.cursor/rules/council-advisors.disabled" ]] && mv "${HOME}/.cursor/rules/council-advisors.disabled" "${HOME}/.cursor/rules/council-advisors"
    [[ -d "${HOME}/.cursor/rules/council-researchers.disabled" ]] && mv "${HOME}/.cursor/rules/council-researchers.disabled" "${HOME}/.cursor/rules/council-researchers"
    echo -e "  ${GREEN}✓${NC} Cursor — enabled"
  fi

  # Windsurf
  if [[ -f "${HOME}/.windsurf/rules/council-of-minds.md.disabled" ]]; then
    mv "${HOME}/.windsurf/rules/council-of-minds.md.disabled" "${HOME}/.windsurf/rules/council-of-minds.md"
    [[ -d "${HOME}/.windsurf/rules/council-advisors.disabled" ]] && mv "${HOME}/.windsurf/rules/council-advisors.disabled" "${HOME}/.windsurf/rules/council-advisors"
    [[ -d "${HOME}/.windsurf/rules/council-researchers.disabled" ]] && mv "${HOME}/.windsurf/rules/council-researchers.disabled" "${HOME}/.windsurf/rules/council-researchers"
    echo -e "  ${GREEN}✓${NC} Windsurf — enabled"
  fi

  # Cline
  if [[ -f "${HOME}/.cline/rules/council-of-minds.md.disabled" ]]; then
    mv "${HOME}/.cline/rules/council-of-minds.md.disabled" "${HOME}/.cline/rules/council-of-minds.md"
    [[ -d "${HOME}/.cline/rules/council-advisors.disabled" ]] && mv "${HOME}/.cline/rules/council-advisors.disabled" "${HOME}/.cline/rules/council-advisors"
    [[ -d "${HOME}/.cline/rules/council-researchers.disabled" ]] && mv "${HOME}/.cline/rules/council-researchers.disabled" "${HOME}/.cline/rules/council-researchers"
    echo -e "  ${GREEN}✓${NC} Cline — enabled"
  fi

  # Aider
  if [[ -d "${HOME}/.aider/council-of-minds.disabled" ]]; then
    mv "${HOME}/.aider/council-of-minds.disabled" "${HOME}/.aider/council-of-minds"
    echo -e "  ${GREEN}✓${NC} Aider — enabled"
  fi

  # RooCode
  if [[ -f "${HOME}/.roo/rules/council-of-minds.md.disabled" ]]; then
    mv "${HOME}/.roo/rules/council-of-minds.md.disabled" "${HOME}/.roo/rules/council-of-minds.md"
    [[ -d "${HOME}/.roo/rules/council-advisors.disabled" ]] && mv "${HOME}/.roo/rules/council-advisors.disabled" "${HOME}/.roo/rules/council-advisors"
    [[ -d "${HOME}/.roo/rules/council-researchers.disabled" ]] && mv "${HOME}/.roo/rules/council-researchers.disabled" "${HOME}/.roo/rules/council-researchers"
    echo -e "  ${GREEN}✓${NC} RooCode — enabled"
  fi

  # OpenCode
  if [[ -d "${HOME}/.opencode/council-of-minds.disabled" ]]; then
    mv "${HOME}/.opencode/council-of-minds.disabled" "${HOME}/.opencode/council-of-minds"
    echo -e "  ${GREEN}✓${NC} OpenCode — enabled"
  fi

  # GitHub Copilot
  if [[ -f "${HOME}/.github/copilot-instructions.md.disabled" ]]; then
    mv "${HOME}/.github/copilot-instructions.md.disabled" "${HOME}/.github/copilot-instructions.md"
    echo -e "  ${GREEN}✓${NC} GitHub Copilot — enabled"
  fi

  # Codex
  if [[ -f "${HOME}/AGENTS.md.disabled" ]]; then
    mv "${HOME}/AGENTS.md.disabled" "${HOME}/AGENTS.md"
    echo -e "  ${GREEN}✓${NC} Codex — enabled"
  fi

  rm -f "$STATE_FILE"
  echo ""
  echo -e "  ${GREEN}Council re-enabled.${NC} Active on next AI session."
  echo ""
}

# ─────────────────────────────────────────────────────────────────────────────
# Custom Advisor Builder
# ─────────────────────────────────────────────────────────────────────────────

# Required section markers a custom advisor must contain to be valid.
CUSTOM_DIR="${INSTALL_DIR}/advisors/custom"
TEMPLATE_FILE="${INSTALL_DIR}/advisors/custom/_template.md"
VALID_EVIDENCE="empirical mechanistic strategic heuristic ethical experiential generative"

advisor_usage() {
  echo ""
  echo -e "  ${PURPLE}${BOLD}council advisor${NC} — manage custom advisors"
  echo ""
  echo "  Subcommands:"
  echo "    create <name>     Scaffold advisors/custom/<name>.md from the template"
  echo "    validate <name>   Check a custom advisor's structure"
  echo "    list              List all custom advisors"
  echo ""
}

# Resolve the source dir when running from a clone (dev) vs installed copy.
advisor_src_dir() {
  if [[ -d "${CUSTOM_DIR}" ]]; then
    echo "${CUSTOM_DIR}"
  elif [[ -d "$(dirname "$0")/../advisors/custom" ]]; then
    ( cd "$(dirname "$0")/../advisors/custom" && pwd )
  else
    echo "${CUSTOM_DIR}"
  fi
}

cmd_advisor_create() {
  local name="$1"
  if [[ -z "$name" ]]; then
    echo -e "  ${RED}✗${NC} Usage: council advisor create <name>"
    exit 1
  fi
  if [[ ! "$name" =~ ^[a-z][a-z0-9-]*$ ]]; then
    echo -e "  ${RED}✗${NC} Name must be lowercase-hyphenated (e.g. risk-quant)."
    exit 1
  fi
  if [[ "$name" == "_template" ]]; then
    echo -e "  ${RED}✗${NC} '_template' is reserved."
    exit 1
  fi

  local dir template target
  dir="$(advisor_src_dir)"
  template="${dir}/_template.md"
  target="${dir}/${name}.md"

  if [[ ! -f "$template" ]]; then
    echo -e "  ${RED}✗${NC} Template not found at ${template}"
    exit 1
  fi
  if [[ -f "$target" ]]; then
    echo -e "  ${RED}✗${NC} ${name}.md already exists. Pick another name or edit it directly."
    exit 1
  fi

  # Seed the scaffold with the chosen name in the member heading.
  sed "s/## {member-name}/## ${name}/" "$template" > "$target"
  echo -e "  ${GREEN}✓${NC} Created ${target}"
  echo -e "    1. Edit it: replace every {placeholder}."
  echo -e "    2. Validate: council advisor validate ${name}"
  echo -e "    3. Reinstall: council install"
}

cmd_advisor_validate() {
  local name="$1"
  if [[ -z "$name" ]]; then
    echo -e "  ${RED}✗${NC} Usage: council advisor validate <name>"
    exit 1
  fi
  local dir file
  dir="$(advisor_src_dir)"
  file="${dir}/${name}.md"
  if [[ ! -f "$file" ]]; then
    echo -e "  ${RED}✗${NC} No such advisor: ${file}"
    exit 1
  fi

  local errors=0
  fail() { echo -e "    ${RED}✗${NC} $1"; errors=$((errors + 1)); }
  pass() { echo -e "    ${GREEN}✓${NC} $1"; }

  echo -e "  Validating ${name}.md..."

  # Single member heading matching filename
  if [[ "$(grep -cE "^## ${name}\$" "$file")" == "1" ]]; then
    pass "member heading '## ${name}' present"
  else
    fail "expected exactly one '## ${name}' heading matching the filename"
  fi

  # Required field headers
  for field in "Cast:" "Reasoning Method:" "Polarity Pairs:" "Evidence Type:"; do
    if grep -qF "**${field}**" "$file"; then
      pass "field '${field}' present"
    else
      fail "missing field '**${field}**'"
    fi
  done

  # Cast value
  if grep -qE '^\*\*Cast:\*\*[[:space:]]*(advisor|researcher)\b' "$file"; then
    pass "Cast is advisor or researcher"
  else
    fail "Cast must be 'advisor' or 'researcher'"
  fi

  # Evidence type value
  local ev
  ev="$(grep -E '^\*\*Evidence Type:\*\*' "$file" | head -1 | sed -E 's/^\*\*Evidence Type:\*\*[[:space:]]*//' | tr -d ' ')"
  if [[ " ${VALID_EVIDENCE} " == *" ${ev} "* ]]; then
    pass "Evidence Type '${ev}' is valid"
  else
    fail "Evidence Type '${ev}' not in: ${VALID_EVIDENCE}"
  fi

  # Required sections
  local sections=(
    "### Analytical Method"
    "### Grounding Protocol"
    "### What This Lens Sees That Others Miss"
    "### What This Lens Tends to Miss"
    "### When Deliberating"
    "### Output Format (Standalone)"
    "### Output Format (Council Round 2)"
  )
  for s in "${sections[@]}"; do
    if grep -qF "$s" "$file"; then
      pass "section '${s}' present"
    else
      fail "missing section '${s}'"
    fi
  done

  # No leftover placeholders (ignore the trailing HTML validation-checklist comment)
  if grep -qE '\{[a-z0-9 ._-]+\}' "$file"; then
    fail "unfilled {placeholders} remain — replace them all"
  else
    pass "no unfilled placeholders"
  fi

  echo ""
  if [[ "$errors" -eq 0 ]]; then
    echo -e "  ${GREEN}✓ ${name}.md is valid.${NC} Run 'council install' to load it."
  else
    echo -e "  ${RED}✗ ${errors} problem(s).${NC} Fix them and re-run validate."
    exit 1
  fi
}

cmd_advisor_list() {
  local dir
  dir="$(advisor_src_dir)"
  echo ""
  echo -e "  ${PURPLE}${BOLD}Custom Advisors${NC}"
  echo ""
  local found=0
  if [[ -d "$dir" ]]; then
    for f in "$dir"/*.md; do
      [[ -e "$f" ]] || continue
      local base
      base="$(basename "$f" .md)"
      [[ "$base" == "_template" || "$base" == "README" ]] && continue
      local cast
      cast="$(grep -E '^\*\*Cast:\*\*' "$f" | head -1 | sed -E 's/^\*\*Cast:\*\*[[:space:]]*//; s/[[:space:]]*<!--.*$//' | tr -d ' ')"
      echo -e "    ${GREEN}•${NC} ${base}  ${CYAN}(${cast:-advisor})${NC}"
      found=$((found + 1))
    done
  fi
  if [[ "$found" -eq 0 ]]; then
    echo -e "    · none yet — run 'council advisor create <name>'"
  fi
  echo ""
}

cmd_advisor() {
  local sub="${1:-help}"
  shift || true
  case "$sub" in
    create)   cmd_advisor_create "$@" ;;
    validate) cmd_advisor_validate "$@" ;;
    list)     cmd_advisor_list ;;
    help|-h|--help) advisor_usage ;;
    *)
      echo -e "  ${RED}Unknown advisor subcommand: ${sub}${NC}"
      advisor_usage
      exit 1
      ;;
  esac
}

# ─────────────────────────────────────────────────────────────────────────────
# Custom researchers (retrieval Minds) — twin of the advisor builder above.
# ─────────────────────────────────────────────────────────────────────────────
RESEARCHER_CUSTOM_DIR="${INSTALL_DIR}/researchers/custom"
VALID_THEMES="evidence provenance adversarial quantitative temporal technical market regulatory human synthesis"

researcher_usage() {
  echo ""
  echo -e "  ${PURPLE}${BOLD}council researcher${NC} — manage custom researchers"
  echo ""
  echo "  Subcommands:"
  echo "    create <name>     Scaffold researchers/custom/<name>.md from the template"
  echo "    validate <name>   Check a custom researcher's structure"
  echo "    list              List all custom researchers"
  echo ""
}

# Resolve the source dir when running from a clone (dev) vs installed copy.
researcher_src_dir() {
  if [[ -d "${RESEARCHER_CUSTOM_DIR}" ]]; then
    echo "${RESEARCHER_CUSTOM_DIR}"
  elif [[ -d "$(dirname "$0")/../researchers/custom" ]]; then
    ( cd "$(dirname "$0")/../researchers/custom" && pwd )
  else
    echo "${RESEARCHER_CUSTOM_DIR}"
  fi
}

cmd_researcher_create() {
  local name="$1"
  if [[ -z "$name" ]]; then
    echo -e "  ${RED}✗${NC} Usage: council researcher create <name>"
    exit 1
  fi
  if [[ ! "$name" =~ ^[a-z][a-z0-9-]*$ ]]; then
    echo -e "  ${RED}✗${NC} Name must be lowercase-hyphenated (e.g. billing-telemetry)."
    exit 1
  fi
  if [[ "$name" == "_template" ]]; then
    echo -e "  ${RED}✗${NC} '_template' is reserved."
    exit 1
  fi

  local dir template target
  dir="$(researcher_src_dir)"
  template="${dir}/_template.md"
  target="${dir}/${name}.md"

  if [[ ! -f "$template" ]]; then
    echo -e "  ${RED}✗${NC} Template not found at ${template}"
    exit 1
  fi
  if [[ -f "$target" ]]; then
    echo -e "  ${RED}✗${NC} ${name}.md already exists. Pick another name or edit it directly."
    exit 1
  fi

  # Seed the scaffold with the chosen name in the researcher heading.
  sed "s/## {researcher-name}/## ${name}/" "$template" > "$target"
  echo -e "  ${GREEN}✓${NC} Created ${target}"
  echo -e "    1. Edit it: replace every {placeholder}."
  echo -e "    2. Validate: council researcher validate ${name}"
  echo -e "    3. Reinstall: council install"
}

cmd_researcher_validate() {
  local name="$1"
  if [[ -z "$name" ]]; then
    echo -e "  ${RED}✗${NC} Usage: council researcher validate <name>"
    exit 1
  fi
  local dir file
  dir="$(researcher_src_dir)"
  file="${dir}/${name}.md"
  if [[ ! -f "$file" ]]; then
    echo -e "  ${RED}✗${NC} No such researcher: ${file}"
    exit 1
  fi

  local errors=0
  fail() { echo -e "    ${RED}✗${NC} $1"; errors=$((errors + 1)); }
  pass() { echo -e "    ${GREEN}✓${NC} $1"; }

  echo -e "  Validating ${name}.md..."

  # Single researcher heading matching filename
  if [[ "$(grep -cE "^## ${name}\$" "$file")" == "1" ]]; then
    pass "researcher heading '## ${name}' present"
  else
    fail "expected exactly one '## ${name}' heading matching the filename"
  fi

  # Required field headers
  for field in "Cast:" "Theme:" "Query Intent:" "Source Class Owned:" "Attack Specialisation:" "Polarity Pairs:"; do
    if grep -qF "**${field}**" "$file"; then
      pass "field '${field}' present"
    else
      fail "missing field '**${field}**'"
    fi
  done

  # Cast value — must be researcher
  if grep -qE '^\*\*Cast:\*\*[[:space:]]*researcher\b' "$file"; then
    pass "Cast is researcher"
  else
    fail "Cast must be 'researcher' for a custom researcher"
  fi

  # Theme value
  local th
  th="$(grep -E '^\*\*Theme:\*\*' "$file" | head -1 | sed -E 's/^\*\*Theme:\*\*[[:space:]]*//' | tr -d ' ')"
  if [[ " ${VALID_THEMES} " == *" ${th} "* ]]; then
    pass "Theme '${th}' is valid"
  else
    fail "Theme '${th}' not in: ${VALID_THEMES}"
  fi

  # Required sections
  local sections=(
    "### Territory Boundary"
    "### Example Queries"
    "### Retrieval Method"
    "### Grounding Protocol"
    "### What This Lens Retrieves That Others Miss"
    "### What This Lens Tends to Miss"
    "### When Cross-Examining"
    "### Output Format (Findings Card)"
    "### Output Format (Cross-Exam)"
  )
  for s in "${sections[@]}"; do
    if grep -qF "$s" "$file"; then
      pass "section '${s}' present"
    else
      fail "missing section '${s}'"
    fi
  done

  # No leftover placeholders (ignore the trailing HTML validation-checklist comment)
  if grep -qE '\{[a-z0-9 ._-]+\}' "$file"; then
    fail "unfilled {placeholders} remain — replace them all"
  else
    pass "no unfilled placeholders"
  fi

  echo ""
  if [[ "$errors" -eq 0 ]]; then
    echo -e "  ${GREEN}✓ ${name}.md is valid.${NC} Run 'council install' to load it."
  else
    echo -e "  ${RED}✗ ${errors} problem(s).${NC} Fix them and re-run validate."
    exit 1
  fi
}

cmd_researcher_list() {
  local dir
  dir="$(researcher_src_dir)"
  echo ""
  echo -e "  ${PURPLE}${BOLD}Custom Researchers${NC}"
  echo ""
  local found=0
  if [[ -d "$dir" ]]; then
    for f in "$dir"/*.md; do
      [[ -e "$f" ]] || continue
      local base
      base="$(basename "$f" .md)"
      [[ "$base" == "_template" || "$base" == "README" ]] && continue
      local theme
      theme="$(grep -E '^\*\*Theme:\*\*' "$f" | head -1 | sed -E 's/^\*\*Theme:\*\*[[:space:]]*//; s/[[:space:]]*<!--.*$//' | tr -d ' ')"
      echo -e "    ${GREEN}•${NC} ${base}  ${CYAN}(${theme:-researcher})${NC}"
      found=$((found + 1))
    done
  fi
  if [[ "$found" -eq 0 ]]; then
    echo -e "    · none yet — run 'council researcher create <name>'"
  fi
  echo ""
}

cmd_researcher() {
  local sub="${1:-help}"
  shift || true
  case "$sub" in
    create)   cmd_researcher_create "$@" ;;
    validate) cmd_researcher_validate "$@" ;;
    list)     cmd_researcher_list ;;
    help|-h|--help) researcher_usage ;;
    *)
      echo -e "  ${RED}Unknown researcher subcommand: ${sub}${NC}"
      researcher_usage
      exit 1
      ;;
  esac
}

# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

case "${1:-help}" in
  install)    shift; cmd_install "$@" ;;
  update)     shift; cmd_update "$@" ;;
  status)     cmd_status ;;
  disable)    cmd_disable ;;
  enable)     cmd_enable ;;
  uninstall)  cmd_uninstall ;;
  advisor)    shift; cmd_advisor "$@" ;;
  researcher) shift; cmd_researcher "$@" ;;
  version|-v|--version) echo "council ${VERSION}" ;;
  help|-h|--help) usage ;;
  *)
    echo -e "  ${RED}Unknown command: $1${NC}"
    usage
    exit 1
    ;;
esac
