{
  "version": "4.0.4",
  "$comment": "Council of Minds is a ROUTER over two co-equal chambers. This file holds ROUTER/GLOBAL configuration only: the neutral 'chambers' routing map, decision-chamber 'modes', and cross-chamber behaviour tables (costBudget, interactiveMode, enforcement). Each chamber's cast lives in its own file: the DECISION chamber in settings/decision-council.config.json, the RESEARCH chamber in settings/research-council.config.json.",
  "chambers": {
    "$comment": "Neutral routing map. Both chambers are peers; neither is subordinate. The orchestrator (council-of-minds.md, Routing / Chamber Selection) classifies each request to one of these.",
    "decision": {
      "modes": [
        "full",
        "quick",
        "duo"
      ],
      "config": "settings/decision-council.config.json",
      "cast": "advisors",
      "verdictContract": "Council Verdict (council-of-minds.md, Chairman Synthesis)"
    },
    "research": {
      "modes": [
        "research"
      ],
      "config": "settings/research-council.config.json",
      "cast": "researchers",
      "verdictContract": "docs/research-verdict-contract.md"
    }
  },
  "modes": {
    "full": {
      "rounds": 5,
      "wordLimits": {
        "round1": 300,
        "round2": 200,
        "round3": 100
      },
      "steps": [
        "restate",
        "analyze",
        "fact-check",
        "cross-examine",
        "crystallize",
        "synthesize"
      ]
    },
    "quick": {
      "rounds": 3,
      "wordLimits": {
        "round1": 200,
        "round2": 75
      },
      "steps": [
        "analyze",
        "fact-check",
        "cross-examine",
        "synthesize"
      ]
    },
    "duo": {
      "rounds": 3,
      "wordLimits": {
        "position": 250,
        "rebuttal": 150
      },
      "steps": [
        "position",
        "rebuttal",
        "synthesize"
      ]
    },
    "research": {
      "$comment": "Research chamber (v4.0), a co-equal peer routed via the top-level 'chambers' map. Full spec in settings/research-council.config.json and the Research Council section of council-of-minds.md. Referenced here only so the mode name resolves within this file.",
      "chamber": "research",
      "rounds": "charter → crystallize-vote",
      "config": "settings/research-council.config.json",
      "verdictContract": "docs/research-verdict-contract.md"
    }
  },
  "enforcement": {
    "dissentQuota": 2,
    "noveltyRequired": true,
    "evidenceDiversityThreshold": 0.8,
    "engagementRequired": true
  },
  "costBudget": {
    "tiers": {
      "minimal": {
        "maxTokens": 3000,
        "mode": "duo",
        "advisors": 2,
        "crossExam": "none"
      },
      "lean": {
        "maxTokens": 8000,
        "mode": "quick",
        "advisors": 4,
        "crossExam": "sparse"
      },
      "standard": {
        "maxTokens": 15000,
        "mode": "quick",
        "advisors": 5,
        "crossExam": "sparse"
      },
      "high": {
        "maxTokens": 25000,
        "mode": "full",
        "advisors": 5,
        "crossExam": "sparse"
      },
      "deep": {
        "maxTokens": 40000,
        "mode": "full",
        "advisors": 6,
        "crossExam": "all-pairs"
      },
      "unlimited": {
        "maxTokens": null,
        "mode": "full",
        "advisors": 6,
        "crossExam": "all-pairs"
      }
    },
    "defaultTier": "high",
    "wordLimitScaling": {
      "minimal": 0.4,
      "lean": 0.6,
      "standard": 0.8,
      "high": 1.0,
      "deep": 1.0,
      "unlimited": 1.0
    }
  },
  "interactiveMode": {
    "enabled": false,
    "description": "When true, all council sessions include checkpoints. When false (default), only triggered by 'interactive council:' or 'council this with checkpoints:'",
    "checkpoints": {
      "afterRound1": true,
      "afterRound2": true,
      "afterCrystallization": false
    },
    "userActions": [
      "continue",
      "inject",
      "remove",
      "redirect",
      "skip-to-verdict"
    ],
    "defaultAction": "continue",
    "maxCheckpoints": 2
  }
}
