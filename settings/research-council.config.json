{
  "$comment": "Council of Minds — Research Council (second chamber) configuration. v4.0-alpha (Phase 15) establishes the retrieval foundation; v4.0-beta (Phase 16) registers the 60 researchers. Tool-neutral and agent-agnostic: no vendor, model, or specific search-provider is named. The host supplies retrieval via the Retrieval Capability Contract below.",
  "version": "4.0.4",
  "peerChamber": {
    "$comment": "Research is one of two co-equal chambers. The decision chamber is configured in settings/decision-council.config.json; the neutral routing map over both lives in settings/council-of-minds.config.json under 'chambers'. This is a peer reference, not a parent.",
    "config": "settings/decision-council.config.json",
    "cast": "advisors"
  },
  "retrievalCapabilityContract": {
    "$comment": "Abstract retrieval interface the host must satisfy. Any client that can search the web and fetch a URL satisfies this; clients without it degrade to a labelled prior-knowledge briefing.",
    "capabilities": {
      "search": {
        "signature": "search(query, filters)",
        "returns": "ranked list of {title, url, snippet, publish_date?, source?}",
        "filters": [
          "recencyWindow",
          "sourceClass",
          "language",
          "jurisdiction",
          "siteScope"
        ],
        "required": true
      },
      "fetch": {
        "signature": "fetch(url)",
        "returns": "{url, canonical_url?, title?, publish_date?, author?, publisher?, text}",
        "required": true
      }
    },
    "capabilityProbe": {
      "$comment": "Run once at session start. Detects which capabilities the host exposes before any researcher is dispatched.",
      "runAt": "session-start",
      "probes": [
        {
          "capability": "search",
          "method": "issue-one-trivial-query",
          "onSuccess": "enable-retrieval",
          "onFailure": "flag-search-unavailable"
        },
        {
          "capability": "fetch",
          "method": "fetch-one-known-url",
          "onSuccess": "enable-fetch",
          "onFailure": "flag-fetch-unavailable"
        }
      ],
      "result": {
        "full": "both search and fetch available -> Research Council may emit a Research Verdict",
        "searchOnly": "snippets only, no full-text -> allowed but every finding flagged [snippet-only, unverified full text]",
        "none": "neither available -> onCapabilityMissing applies"
      }
    },
    "onCapabilityMissing": {
      "$comment": "The one unrecoverable failure mode is silently fabricating citations. If retrieval is unavailable, the chamber MUST NOT emit a Research Verdict.",
      "mode": "degrade-to-briefing",
      "rule": "MUST refuse to emit a Research Verdict without retrieval. Instead emit a clearly labelled PRIOR-KNOWLEDGE BRIEFING that (a) states retrieval was unavailable, (b) carries NO citations, (c) caps every claim confidence at 'low', and (d) lists the queries that WOULD have been run so the user can retrieve manually.",
      "forbidden": "Never present prior-knowledge claims as if they were retrieved and sourced."
    }
  },
  "sourceStore": {
    "$comment": "Shared evidence ledger. Every fetched artifact is registered once here; researchers reference sources by canonical_id.",
    "recordSchema": {
      "canonical_id": "stable hash identifying the source (see canonicalIdAlgorithm)",
      "independence_group": "id shared by sources that are NOT independent (see independenceGrouping)",
      "first_claimer": "canonical_id of the earliest source making this claim, if known",
      "fetched_by": "researcher id that retrieved this source",
      "fetched_at": "ISO-8601 timestamp of retrieval",
      "publish_date": "ISO-8601 publish date if known, else null",
      "class": "source class (see sourceClasses)",
      "verification": "unverified | verified | demoted (set by the Verification Ledger in Phase 17)",
      "url": "resolved URL or DOI",
      "title": "source title"
    },
    "canonicalIdAlgorithm": {
      "$comment": "Deterministic identity so the same source fetched twice collides.",
      "rule": "hash(normalized_url | DOI | (title + publish_date))",
      "precedence": [
        "DOI",
        "normalized_url",
        "title+publish_date"
      ],
      "normalization": [
        "lowercase host",
        "strip scheme and www.",
        "strip tracking query params (utm_*, ref, fbclid, gclid)",
        "strip trailing slash and fragment",
        "resolve known shorteners before hashing"
      ]
    },
    "independenceGrouping": {
      "$comment": "N sources from one origin count as ONE for coverage and confidence.",
      "rule": "group by union of {publisher, author, syndication_origin}",
      "signals": [
        "same publisher / domain owner",
        "same author or byline",
        "wire-service / syndication origin (reprint of the same copy)",
        "same funding source for the underlying study"
      ],
      "effect": "confidence and citation-coverage metrics count independence_groups, not raw source count"
    },
    "sourceClasses": [
      "peer-reviewed",
      "preprint",
      "primary-document",
      "dataset",
      "standard-spec",
      "code-repository",
      "official-docs",
      "filing-financial",
      "regulatory-legal",
      "news-reporting",
      "analyst-report",
      "vendor-material",
      "community-forum",
      "expert-commentary",
      "archive-cache"
    ]
  },
  "fetchDedupe": {
    "$comment": "A canonical-id collision on fetch is not wasted budget — it is a signal to diversify.",
    "rule": "before recording, compute canonical_id; if it already exists in the Source Store, do not double-count",
    "quotaRefund": "refund the fetch against the researcher's budget and require the next fetch to target a DIFFERENT independence_group",
    "effect": "collisions push the panel toward source diversity rather than penalising it"
  },
  "diminishingReturnsStop": {
    "$comment": "Halt retrieval when new fetches stop adding new claims.",
    "rule": "halt a researcher's retrieval when the last 3 fetches each yield < 20% novel claims relative to the Source Store",
    "noveltyMeasure": "fraction of claims in a fetched source not already asserted by a registered source",
    "floor": "always allow at least the tier-minimum fetches before this rule can trigger"
  },
  "researchModes": {
    "$comment": "Round flow (Charter → Crystallize & Vote) wired into the orchestrator (council-of-minds.md, Research Round Flow section) in Phase 17.",
    "research": {
      "rounds": [
        "charter",
        "lens-query",
        "retrieve-analyze",
        "factcheck",
        "cross-exam",
        "progressive-retrieve",
        "enforcement-scan",
        "crystallize-vote"
      ],
      "roundsCapped": true,
      "roundsAreNotAThrottle": "extra rounds cause over-deliberation drift; budget is spent on retrieval dimensions, never on adding rounds",
      "contextIsolationUntil": "cross-exam",
      "crossExamination": {
        "topology": "sparse-O(N)",
        "targetsPerResearcher": "2-3",
        "polarityPaired": true,
        "allPairs": false
      },
      "legalMoves": [
        "SOURCE-CHALLENGE",
        "INFERENCE-CHALLENGE",
        "COVERAGE-CHALLENGE"
      ],
      "antiConformity": "evidence-gated: concession requires a named specific flaw AND a cited source id",
      "factChecker": {
        "retrieves": true,
        "debates": false,
        "votes": false,
        "checks": [
          "existence",
          "quote-fidelity",
          "date-currency",
          "entailment",
          "independence"
        ],
        "unverified": "demoted-to-open-questions-never-deleted"
      },
      "vote": "per-claim confidence, never a single report-level number",
      "confidenceCaps": {
        "singleIndependenceGroup": 0.5,
        "unverifiedOrDemoted": 0.4
      },
      "verdictContract": "docs/research-verdict-contract.md",
      "status": "active"
    }
  },
  "triggers": {
    "$comment": "Phase 19. Explicit triggers always route to research mode; auto-detect routes when the question asks what IS (a state of the world) with no options enumerated.",
    "explicit": [
      "research council:",
      "sourced council:",
      "council with research:",
      "cite this:"
    ],
    "budgetShortcuts": {
      "lean research council:": "lean",
      "research council:": "standard",
      "deep research council:": "deep"
    },
    "autoDetect": {
      "recencyTerms": [
        "latest",
        "current",
        "as of",
        "this week",
        "this month",
        "this year",
        "newest",
        "up to date"
      ],
      "phrasings": [
        "what is the current",
        "what is the latest",
        "is it true that",
        "what does the evidence say",
        "how many",
        "who currently"
      ],
      "signals": [
        "asks what IS not what to DO",
        "no options enumerated to choose between"
      ]
    },
    "onAmbiguous": "ask once at the Charter stage whether the user wants a decision or a research answer; never guess"
  },
  "budgetTiers": {
    "$comment": "Phase 19. Budget applies across RETRIEVAL dimensions, not word limits. Degradation order is critical: fact-check is sacrificed LAST because independent grounding is the proven unlock (arXiv 2606.02866). Rounds are NEVER a throttle (2607.09099, 2502.19559).",
    "dimensions": [
      "panel",
      "queriesPerResearcher",
      "fetchesPerResearcher",
      "progressivePasses",
      "factCheckScope"
    ],
    "tiers": {
      "minimal": {
        "panel": 4,
        "queriesPerResearcher": 2,
        "fetchesPerResearcher": 3,
        "progressivePasses": 0,
        "factCheckScope": "sample-30%"
      },
      "lean": {
        "panel": 4,
        "queriesPerResearcher": 3,
        "fetchesPerResearcher": 5,
        "progressivePasses": 0,
        "factCheckScope": "load-bearing-only"
      },
      "standard": {
        "panel": 5,
        "queriesPerResearcher": 4,
        "fetchesPerResearcher": 8,
        "progressivePasses": 1,
        "factCheckScope": "all"
      },
      "high": {
        "panel": 5,
        "queriesPerResearcher": 5,
        "fetchesPerResearcher": 12,
        "progressivePasses": 2,
        "factCheckScope": "all"
      },
      "deep": {
        "panel": 6,
        "queriesPerResearcher": 6,
        "fetchesPerResearcher": 18,
        "progressivePasses": 3,
        "factCheckScope": "all+independence-trace"
      },
      "unlimited": {
        "panel": 8,
        "queriesPerResearcher": "inf",
        "fetchesPerResearcher": "inf",
        "progressivePasses": 5,
        "factCheckScope": "all+independence-trace"
      }
    },
    "degradationOrder": [
      "progressivePasses",
      "fetchesPerResearcher",
      "queriesPerResearcher",
      "panel",
      "factCheckScope"
    ],
    "roundsAreNotAThrottle": true,
    "default": "standard"
  },
  "selectorConstraint": {
    "$comment": "Phase 19. Every research panel must be able to audit and to disconfirm.",
    "mustInclude": [
      {
        "theme": "synthesis",
        "min": 1,
        "why": "nothing audits the collected set without it"
      },
      {
        "theme": "adversarial",
        "min": 1,
        "why": "without it the panel only confirms"
      }
    ],
    "panelSize": {
      "min": 4,
      "max": 6,
      "default": 5,
      "maxAtDeepOrUnlimited": 8
    },
    "polarityPair": "include at least one researchPolarityPairs pair (cross-theme most valuable)"
  },
  "modelDiversity": {
    "$comment": "Phase 19. Reuses the decision-council model-assignment algorithm (Phase 8), clustering by source class instead of evidence type. Tool-neutral: named model slots are abstract (model-a/b/c), resolved by the host.",
    "algorithm": "group researchers by source-class cluster, map each cluster to a distinct model slot, enforce no single model > 50% of panel",
    "singleModelFallback": "retrieval-variation directives (breadth-first vs depth-first vs adversarial query framing)",
    "reuses": "Phase 8 multi-model assignment"
  },
